# MySQL 数据库配置（与主项目 game-platform 共用）
# 复制此文件为 .env 并修改配置

# MySQL 连接配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=game_platform

# 说明：
# 1. 此配置用于爬虫服务把数据写入主项目的 MySQL 数据库
# 2. 数据会写入 crawl_data 表，通过 source_id/vendor_id/agent_user_id 隔离
# 3. 表头中文化通过 crawl_field_mapping 表配置
# 4. 如果不配置 MySQL，爬虫服务将仅使用 SQLite（data/crawler.db）
